def read_ess(client):
    rr_soc = client.read_holding_registers(199, 1, unit=UNIT)
    if rr_soc.isError():
        raise RuntimeError(f"讀 SOC 失敗: {rr_soc}")
    soc = rr_soc.registers[0] / 100.0

    rr_p = client.read_holding_registers(300, 2, unit=UNIT)
    if rr_p.isError():
        raise RuntimeError(f"讀 ESS 功率失敗: {rr_p}")
    p_kw = decode_int32_be(rr_p.registers) / 1000.0

    return soc, p_kw


def read_meter(client):
    rr = client.read_holding_registers(16450, 2, unit=UNIT)
    if rr.isError():
        raise RuntimeError(f"讀電表功率失敗: {rr}")
    power_kw = decode_float_be(rr.registers) / 1000.0
    return power_kw


